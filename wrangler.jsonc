{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fonscape-blog",
  "main": "worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/audio", "/audio/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 3 * * SUN"]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d0a6b76356354d6fa7ccdfc834eb1107",
      
      // Optional: preview_id used when running `wrangler dev` for local dev
      "preview_id": "<ID_OF_PREVIEW_KV_NAMESPACE_FOR_LOCAL_DEVELOPMENT>"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fonscape-community",
      "migrations_dir": "migrations","database_id": "3fa03b2d-4b3e-4cba-9468-a54318ea45a7"
    }
  ]
}
